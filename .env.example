# AWS Credentials (optional — if empty, falls back to AWS CLI env vars / ~/.aws/credentials / instance profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Gateway Auth (required — must match Open WebUI's STT_OPENAI_API_KEY and TTS_OPENAI_API_KEY)
GATEWAY_API_KEY=changeme

# Gateway Server
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
LOG_FORMAT=console
LOG_LEVEL=INFO

# Transcribe
TRANSCRIBE_LANGUAGE_CODE=
MAX_FILE_SIZE_MB=25

# Polly
DEFAULT_VOICE_ID=Matthew
POLLY_ENGINE=generative

# Reliability
TRANSCRIBE_TIMEOUT_SECONDS=30
POLLY_TIMEOUT_SECONDS=15
MAX_RETRIES=2
RETRY_BASE_DELAY=0.5

# Rate limiting (slowapi format: "60/minute", "10/second", etc.)
RATE_LIMIT=60/minute

# Request size limit in bytes (0 = disabled). Default ~25MB + overhead.
MAX_REQUEST_BYTES=26214400
